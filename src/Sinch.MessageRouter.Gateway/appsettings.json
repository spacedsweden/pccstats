{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "Auth": {
    "Enabled": false,
    "ApiKeys": [
      "change-me-in-production"
    ]
  },

  "Sinch": {
    "ProjectId": "",
    "AppId": "",
    "AccessKeyId": "",
    "AccessKeySecret": "",
    "BaseUrl": "https://us.conversation.api.sinch.com",
    "Region": "us",
    "TimeoutSeconds": 30
  },

  "RateLimiting": {
    "PerKeyLimit": 1000,
    "GlobalLimit": 10000
  },

  "Otel": {
    "ServiceName": "sinch-message-router",
    "OtlpEndpoint": "http://localhost:4317"
  },

  "Channels": {
    "Sms": { "DefaultSender": "" },
    "Mms": { "DefaultSender": "" },
    "Rcs": { "DefaultSender": "" },
    "WhatsApp": { "DefaultSender": "" },
    "Messenger": { "DefaultSender": "" },
    "Viber": { "DefaultSender": "" },
    "Telegram": { "DefaultSender": "" },
    "Line": { "DefaultSender": "" },
    "KakaoTalk": { "DefaultSender": "" },
    "Instagram": { "DefaultSender": "" }
  },

  "Webhooks": {
    "RetryCount": 3,
    "TimeoutSeconds": 30,
    "MaxConcurrentDeliveries": 10
  },

  "ReverseProxy": {
    "Routes": {
      "sinch-conversation": {
        "ClusterId": "sinch-api",
        "Match": {
          "Path": "/v1/sinch/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/conversation/v1/projects/{**remainder}" },
          { "RequestHeader": "Content-Type", "Set": "application/json" }
        ]
      }
    },
    "Clusters": {
      "sinch-api": {
        "Destinations": {
          "primary": {
            "Address": "https://us.conversation.api.sinch.com"
          }
        },
        "HttpClient": {
          "RequestHeaderEncoding": "utf-8"
        }
      }
    }
  }
}
