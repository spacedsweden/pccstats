{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "Sinch": {
    "ProjectId": "",
    "AppId": "",
    "AccessKeyId": "",
    "AccessKeySecret": "",
    "BaseUrl": "https://us.conversation.api.sinch.com",
    "Region": "us"
  },

  "Gateway": {
    "ApiKeys": [
      "change-me-in-production"
    ]
  },

  "RateLimiting": {
    "FixedWindow": {
      "PermitLimit": 1000,
      "WindowSeconds": 60,
      "QueueLimit": 50
    }
  },

  "Otel": {
    "ServiceName": "sinch-message-router",
    "OtlpEndpoint": "http://localhost:4317",
    "PrometheusPort": 9464
  },

  "ChannelDefaults": {
    "Sms": {
      "DefaultSender": ""
    },
    "Mms": {
      "DefaultSender": ""
    },
    "Rcs": {
      "DefaultSender": ""
    },
    "WhatsApp": {
      "DefaultSender": ""
    },
    "Messenger": {
      "DefaultSender": ""
    },
    "Viber": {
      "DefaultSender": ""
    },
    "Telegram": {
      "DefaultSender": ""
    },
    "Line": {
      "DefaultSender": ""
    },
    "KakaoTalk": {
      "DefaultSender": ""
    },
    "Instagram": {
      "DefaultSender": ""
    }
  },

  "Webhooks": {
    "RetryCount": 3,
    "TimeoutSeconds": 30,
    "MaxConcurrentDeliveries": 10
  },

  "ReverseProxy": {
    "Routes": {
      "sinch-conversation": {
        "ClusterId": "sinch-api",
        "Match": {
          "Path": "/v1/sinch/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/conversation/v1/projects/{ProjectId}/{**remainder}" },
          { "RequestHeader": "Content-Type", "Set": "application/json" }
        ]
      },
      "sinch-conversation-messages": {
        "ClusterId": "sinch-api",
        "Match": {
          "Path": "/v1/sinch/messages/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/conversation/v1/projects/{ProjectId}/messages:send" },
          { "RequestHeader": "Content-Type", "Set": "application/json" }
        ]
      }
    },
    "Clusters": {
      "sinch-api": {
        "Destinations": {
          "primary": {
            "Address": "https://us.conversation.api.sinch.com"
          }
        },
        "HttpClient": {
          "RequestHeaderEncoding": "utf-8"
        }
      }
    }
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ],
    "AllowedMethods": [ "GET", "POST", "PATCH", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "Content-Type", "Authorization", "X-API-Key", "X-Correlation-Id" ]
  }
}
